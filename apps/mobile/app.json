{
  "expo": {
    "name": "Fluxo",
    "slug": "fluxo-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fluxo",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "br.com.fluxosocial.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.fluxosocial.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#030711"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Fluxo usa suas fotos para você criar posts.",
          "cameraPermission": "O Fluxo usa a câmera para você fotografar e criar posts.",
          "microphonePermission": "O Fluxo usa o microfone para gravar vídeos nos seus posts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Fluxo usa sua localização para sugerir comunidades locais e, se você ativar, mostrar pessoas próximas. Sua localização exata nunca aparece para ninguém."
        }
      ]
    ],
    "extra": {
      "appName": "Fluxo",
      "eas": {
        "projectId": "48bb0ac4-0fdd-4b4c-a4f3-b3dc0c08f5e2"
      }
    },
    "owner": "aura_labs"
  }
}
